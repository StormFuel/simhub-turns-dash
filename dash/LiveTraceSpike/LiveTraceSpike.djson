          "HorizontalAlignment": 0,
          "VerticalAlignment": 1,
          "TextPadding": {},
          "BackgroundColor": "#00FFFFFF",
          "BorderStyle": {},
          "Bindings": {
            "Text": {
              "Formula": {
                "JSExt": 3,
                "Interpreter": 1,
                "Expression": "var g=$prop('DataCorePlugin.CurrentGame')||'NO GAME';var t=$prop('DataCorePlugin.GameData.NewData.TrackName')||'';var c=$prop('DataCorePlugin.GameData.NewData.CarModel')||'';return [g,t,c].filter(function(s){return s;}).join('  ·  ').toUpperCase();"
              },
              "Mode": 2
            }
          }
        },
