              "Formula": {
                "Expression": "max(2, (isnull([TurnTelemetry.Sector.1.End],-1) - isnull([TurnTelemetry.Sector.1.Start],-1)) * 1060 - 2)"
              },
              "Mode": 2,
              "TargetPropertyName": "Width"
            },
