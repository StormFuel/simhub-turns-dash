              "Formula": {
                "Expression": "if(isnull([TurnTelemetry.Sector.1.State],'NONE')='NONE','#14FFFFFF',if(isnull([TurnTelemetry.Sector.1.FromLastLap],false),if(isnull([TurnTelemetry.Sector.1.State],'NONE')='SESSIONBEST','#59B44BFF',if(isnull([TurnTelemetry.Sector.1.State],'NONE')='PERSONALBEST','#592EE66B',if(isnull([TurnTelemetry.Sector.1.State],'NONE')='SLOWER','#59FFD000',if(isnull([TurnTelemetry.Sector.1.State],'NONE')='INVALID','#59FF2D2D','#14FFFFFF')))),if(isnull([TurnTelemetry.Sector.1.State],'NONE')='SESSIONBEST','#FFB44BFF',if(isnull([TurnTelemetry.Sector.1.State],'NONE')='PERSONALBEST','#FF2EE66B',if(isnull([TurnTelemetry.Sector.1.State],'NONE')='SLOWER','#FFFFD000',if(isnull([TurnTelemetry.Sector.1.State],'NONE')='INVALID','#FFFF2D2D','#14FFFFFF'))))))"
              },
