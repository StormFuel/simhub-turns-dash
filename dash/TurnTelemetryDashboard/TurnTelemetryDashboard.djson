          "Name": "Session",
          "IsTextItem": true,
          "Font": "Oswald",
          "FontWeight": "Bold",
          "FontStyle": "Normal",
          "FontSize": 22.0,
          "Text": "",
          "TextColor": "#FFB4B4B4",
          "HorizontalAlignment": 0,
          "VerticalAlignment": 1,
          "TextPadding": {},
          "BackgroundColor": "#00FFFFFF",
          "BorderStyle": {},
          "Bindings": {
            "Text": {
              "Formula": {
                "JSExt": 3,
                "Interpreter": 1,
                "Expression": "var names={AssettoCorsa:'AC',AssettoCorsaCompetizione:'ACC',IRacing:'IRACING',LMU:'LE MANS ULTIMATE',RFactor2:'RFACTOR 2',Automobilista2:'AMS2',RRRE:'RACEROOM',FH4:'FORZA HORIZON 4',FH5:'FORZA HORIZON 5',FH6:'FORZA HORIZON 6'};var code=$prop('DataCorePlugin.CurrentGame'); var g=names[code]||code||'NO GAME';var t=$prop('DataCorePlugin.GameData.NewData.TrackName')||'';var c=$prop('DataCorePlugin.GameData.NewData.CarModel')||'';return [g,t,c].filter(function(s){return s;}).join('  ·  ').toUpperCase();"
              },
              "Mode": 2
            }
          }
        },
