          "TextPadding": {},
          "BackgroundColor": "#00FFFFFF",
          "BorderStyle": {},
          "Bindings": {
            "Visible": {
              "Formula": {
                "Expression": "isnull([TurnTelemetry.Turn.Band.39.Start],-1) >= 0"
              },
              "Mode": 2,
              "TargetPropertyName": "Visible"
            },
            "Left": {
              "Formula": {
                "Expression": "420 + ((isnull([TurnTelemetry.Turn.Band.39.Start],-1) + if(isnull([TurnTelemetry.Turn.Band.39.End],-1) >= isnull([TurnTelemetry.Turn.Band.39.Start],-1), isnull([TurnTelemetry.Turn.Band.39.End],-1), isnull([TurnTelemetry.Turn.Band.39.End],-1) + 1)) / 2) % 1 * 1060 - 20"
              },
              "Mode": 2,
              "TargetPropertyName": "Left"
            },
            "Text": {
              "Formula": {
                "Expression": "isnull([TurnTelemetry.Turn.Band.39.Label],'')"
              },
              "Mode": 2,
              "TargetPropertyName": "Text"
            },
            "TextColor": {
              "Formula": {
                "Expression": "if([TurnTelemetry.Turn.Band.39.IsCurrent],'#FF2F7DFF',if(isnull([TurnTelemetry.Turn.Band.39.LimitsLap],0) > 0,'#FFFF2D2D','#FFB4B4B4'))"
              },
              "Mode": 2,
              "TargetPropertyName": "TextColor"
            }
          }
        },
