          "Name": "Band 39 limits",
          "IsRectangleItem": true,
          "BackgroundColor": "#FFFF2D2D",
          "BorderStyle": {},
          "Bindings": {
            "Visible": {
              "Formula": {
                "Expression": "isnull([TurnTelemetry.Turn.Band.39.Start],-1) >= 0 && isnull([TurnTelemetry.Turn.Band.39.LimitsSession],0) > 0"
              },
              "Mode": 2,
              "TargetPropertyName": "Visible"
            },
            "Left": {
              "Formula": {
                "Expression": "420 + isnull([TurnTelemetry.Turn.Band.39.Start],-1) * 1060"
              },
              "Mode": 2,
              "TargetPropertyName": "Left"
            },
            "Width": {
              "Formula": {
                "Expression": "max(6, if(isnull([TurnTelemetry.Turn.Band.39.End],-1) >= isnull([TurnTelemetry.Turn.Band.39.Start],-1), isnull([TurnTelemetry.Turn.Band.39.End],-1) - isnull([TurnTelemetry.Turn.Band.39.Start],-1), 1 - isnull([TurnTelemetry.Turn.Band.39.Start],-1)) * 1060)"
              },
              "Mode": 2,
              "TargetPropertyName": "Width"
            },
            "BackgroundColor": {
              "Formula": {
                "Expression": "if(isnull([TurnTelemetry.Turn.Band.39.LimitsLap],0) > 0,'#FFFF2D2D','#66FF2D2D')"
              },
              "Mode": 2,
              "TargetPropertyName": "BackgroundColor"
            }
          }
        },
        {
          "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
          "Left": 420.0,
          "Top": 170.0,
          "Width": 40.0,
          "Height": 26.0,
          "Visible": true,
          "Name": "Band 39 label",
          "IsTextItem": true,
          "Font": "Oswald",
          "FontWeight": "Bold",
          "FontStyle": "Normal",
          "FontSize": 18.0,
