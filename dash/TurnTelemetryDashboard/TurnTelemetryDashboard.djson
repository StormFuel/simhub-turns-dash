        },
        {
          "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
          "Left": 800.0,
          "Top": 118.0,
          "Width": 680.0,
          "Height": 26.0,
          "Visible": true,
          "Name": "Turn source",
          "IsTextItem": true,
          "Font": "Oswald",
          "FontWeight": "Bold",
          "FontStyle": "Normal",
          "FontSize": 16.0,
          "Text": "",
          "TextColor": "#FFB4B4B4",
          "HorizontalAlignment": 2,
          "VerticalAlignment": 1,
          "TextPadding": {},
          "BackgroundColor": "#00FFFFFF",
          "BorderStyle": {},
          "Bindings": {
            "Text": {
              "Formula": {
                "JSExt": 3,
                "Interpreter": 1,
                "Expression": "if(!$prop('TurnTelemetry.Caps.LapPosition')) return '';var src=$prop('TurnTelemetry.Turn.Source')||'none'; var n=$prop('TurnTelemetry.Turn.Count')||0;if(src==='none') return 'NO TURN DATA · USE THE TURN EDITOR IN THE PLUGIN SETTINGS';if(src.indexOf('auto')===0) return 'TURNS · AUTO-NUMBERED · ' + n + ' · REVIEW IN THE TURN EDITOR';return 'TURNS · ' + src.toUpperCase() + ' · ' + n;"
              },
              "Mode": 2
            }
          }
        },
