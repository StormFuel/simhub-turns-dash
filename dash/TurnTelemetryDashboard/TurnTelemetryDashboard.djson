          "TextPadding": {},
          "BackgroundColor": "#00FFFFFF",
          "BorderStyle": {},
          "Bindings": {
            "Visible": {
              "Formula": {
                "Expression": "isnull([TurnTelemetry.Limits.SessionTotal],0) > 0 && isnull([TurnTelemetry.Limits.Available],true)"
              },
              "Mode": 2,
              "TargetPropertyName": "Visible"
            },
            "Text": {
              "Formula": {
                "JSExt": 3,
                "Interpreter": 1,
                "Expression": "return 'TRACK LIMITS  ' + ($prop('TurnTelemetry.Limits.SessionTotal')||0);"
              },
              "Mode": 2
            }
          }
        },
        {
          "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
